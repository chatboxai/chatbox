{
  "name": "xyz.workspaiceapp.ce",
  "productName": "xyz.workspaiceapp.ce",
  "version": "1.0.3",
  "engines": {
    "node": ">=22.12.0 <25.0.0",
    "pnpm": ">=10.17.0"
  },
  "private": true,
  "description": "A desktop client for multiple cutting-edge AI models",
  "main": "out/main/main.js",
  "scripts": {
    "generate:model-snapshot": "pnpm exec tsx scripts/generate-model-snapshot.ts",
    "build": "electron-vite build",
    "build:main": "electron-vite build",
    "build:preload": "electron-vite build",
    "build:renderer": "electron-vite build",
    "delete-sourcemaps": "node ./.erb/scripts/delete-source-maps.cjs",
    "postinstall": "node .erb/scripts/postinstall.cjs",
    "package": "ts-node ./.erb/scripts/clean.js && pnpm run build && electron-builder build --publish never",
    "package:all": "ts-node ./.erb/scripts/clean.js && pnpm run build && electron-builder build --publish never --win --mac --linux",
    "release:mac": "bash release-mac.sh",
    "release:linux": "bash release-linux.sh",
    "release:win": "bash release-win.sh",
    "electron:publish-mac": "pnpm run build && electron-builder build --publish always --mac",
    "electron:publish-linux": "pnpm run build && electron-builder build --publish always --linux",
    "electron:publish-win": "pnpm run build && electron-builder build --publish always --win",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "dev": "pnpm start",
    "dev:local": "cross-env USE_LOCAL_API=true pnpm start",
    "dev:debug": "cross-env MAIN_ARGS=\"--inspect=5858\" pnpm start",
    "start": "electron-vite dev",
    "start:cdp": "electron-vite dev -- --remote-debugging-port=9333",
    "start:main": "cross-env NODE_ENV=development electronmon -r ts-node/register/transpile-only .",
    "start:preload": "electron-vite build --preload --watch",
    "start:renderer": "electron-vite",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration --testTimeout=300000",
    "test:file-conversation": "vitest run --config vitest.integration.config.ts test/integration/file-conversation",
    "test:model-provider": "vitest run test/integration/model-provider --testTimeout=120000",
    "qa:biome": "node scripts/qa/biome-changed.mjs",
    "qa:biome-ratchet": "node scripts/qa/biome-ratchet.mjs",
    "qa:no-skipped": "node scripts/qa/no-skipped-tests.mjs",
    "qa:unit": "vitest run --config vitest.unit.config.ts",
    "qa:integration": "vitest run --config vitest.integration.config.ts",
    "qa:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "qa:e2e": "pnpm build && playwright test --config playwright.config.ts",
    "qa:ci": "pnpm check && pnpm qa:biome && pnpm qa:biome-ratchet && pnpm qa:no-skipped && pnpm qa:unit && pnpm qa:integration && pnpm qa:coverage && pnpm build && playwright test --config playwright.config.ts",
    "qa:release:mac": "pnpm qa:release:mac:arm64",
    "qa:release:mac:arm64": "pnpm build && pnpm exec electron-builder --mac --arm64 --publish never -c.mac.target.arch=arm64",
    "qa:release:mac:x64": "pnpm build && pnpm exec electron-builder --mac --x64 --publish never -c.mac.target.arch=x64",
    "qa:release:win": "pnpm build && pnpm exec electron-builder --win --x64 --publish never",
    "eval:session-rag": "node scripts/session-rag-eval/run-session-rag-eval.mjs",
    "eval:session-rag:workspaice": "node scripts/session-rag-eval/run-workspaice-flow-eval.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "npx tsc --noEmit",
    "format": "biome format --write",
    "check:biome": "biome check",
    "check:ci": "biome ci",
    "prepare": "node -e \"try { require('husky') } catch(e) { process.exit(0) }\" && husky || true",
    "check:error-i18n-keys": "node script/sync-error-i18n-keys.mjs --check",
    "sync:error-i18n-keys": "node script/sync-error-i18n-keys.mjs",
    "translate": "pnpm run sync:error-i18n-keys && i18next && node script/translate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/workspaiceai/workspaice.git"
